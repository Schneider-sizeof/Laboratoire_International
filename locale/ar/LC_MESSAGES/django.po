msgstr "خبراء في خدمتكم"

msgid "Certifications"
msgstr "الشهادات"

msgid "Qualité certifiée"
msgstr "جودة معتمدة"

# Team
msgid "Directeur Général & Biologiste"
msgstr "المدير العام وعالم الأحياء"

msgid "Plus de 20 ans d'expérience en biologie médicale. Diplômé de la Faculté de Médecine et Pharmacie de Rabat."
msgstr "أكثر من 20 عامًا من الخبرة في البيولوجيا الطبية. خريج كلية الطب والصيدلة بالرباط."

msgid "Biologiste Spécialiste"
msgstr "أخصائي في علم الأحياء"

msgid "Spécialiste en hématologie et immunologie. Formation complémentaire à l'Institut Pasteur de Paris."
msgstr "متخصص في أمراض الدم والمناعة. تدريب إضافي في معهد باستور بباريس."

msgid "Responsable Qualité"
msgstr "مسؤول الجودة"

msgid "Expert en assurance qualité des laboratoires. Certifié ISO 15189 et accrédité COFRAC."
msgstr "خبير في ضمان جودة المختبرات. حاصل على شهادة ISO 15189 واعتماد COFRAC."

# Values
msgid "Excellence"
msgstr "التميز"

msgid "Nous visons l'excellence dans chaque analyse, avec des équipements de dernière génération."
msgstr "نسعى للتميز في كل تحليل، بأحدث الأجهزة."

msgid "Humanité"
msgstr "الإنسانية"

msgid "Chaque patient est accueilli avec bienveillance, respect et professionnalisme."
msgstr "يُستقبل كل مريض بعناية واحترام ومهنية."

msgid "Fiabilité"
msgstr "الموثوقية"

msgid "Des résultats fiables et reproductibles, conformes aux standards internationaux."
msgstr "نتائج موثوقة وقابلة للتكرار، تتوافق مع المعايير الدولية."

msgid "Innovation"
msgstr "الابتكار"

msgid "Investissement continu dans les technologies les plus avancées du diagnostic médical."
msgstr "استثمار مستمر في أحدث تقنيات التشخيص الطبي."

