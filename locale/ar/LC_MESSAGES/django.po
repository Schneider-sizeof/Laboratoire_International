# Services
msgid "Biochimie"
msgstr "الكيمياء الحيوية"

msgid "Analyses biochimiques complètes incluant glycémie, cholestérol, bilan hépatique et rénal."
msgstr "تحاليل كيميائية حيوية شاملة تشمل السكر في الدم، الكوليسترول، فحص الكبد والكلى."

msgid "Hématologie"
msgstr "أمراض الدم"

msgid "Numération formule sanguine, vitesse de sédimentation, bilan de coagulation."
msgstr "تعداد الدم الكامل، سرعة الترسيب، فحص التخثر."

msgid "Microbiologie"
msgstr "علم الأحياء الدقيقة"

msgid "Culture bactérienne, antibiogramme, examen cytobactériologique des urines."
msgstr "زراعة بكتيرية، مضاد حيوي، فحص البول الخلوي البكتيري."

msgid "Sérologie & Immunologie"
msgstr "الأمصال والمناعة"

msgid "Dépistage des maladies infectieuses, bilan immunitaire, tests sérologiques."
msgstr "الكشف عن الأمراض المعدية، فحص المناعة، اختبارات مصلية."

msgid "Fertilité & Gynécologie"
msgstr "الخصوبة وأمراض النساء"

msgid "Bilan hormonal, spermogramme, suivi de grossesse, dépistage prénatal."
msgstr "فحص هرموني، تحليل السائل المنوي، متابعة الحمل، فحص ما قبل الولادة."

msgid "PCR & Virologie"
msgstr "PCR والفيروسات"

msgid "Tests PCR, charge virale, dépistage COVID-19, hépatites et autres virus."
msgstr "اختبارات PCR، الحمل الفيروسي، الكشف عن كوفيد-19، التهاب الكبد وفيروسات أخرى."

# Partnerships
msgid "Partenariats"
msgstr "الشراكات"

msgid "Nos Partenaires de Confiance"
msgstr "شركاؤنا الموثوقون"

msgid "Nous collaborons avec les plus grands réseaux de diagnostic pour vous garantir des résultats de référence."
msgstr "نتعاون مع أكبر شبكات التشخيص لضمان نتائج مرجعية."

msgid "Réseau européen de diagnostic de référence. Leader en biologie spécialisée avec plus de 50 ans d'expertise."
msgstr "شبكة التشخيص المرجعية الأوروبية. رائدة في علم الأحياء المتخصص مع أكثر من 50 عامًا من الخبرة."

msgid "Lab National Mohammed VI"
msgstr "المختبر الوطني محمد السادس"

msgid "Laboratoire national de référence du Maroc. Partenaire pour les analyses spécialisées et le contrôle qualité."
msgstr "المختبر الوطني المرجعي بالمغرب. شريك في التحاليل المتخصصة ومراقبة الجودة."

