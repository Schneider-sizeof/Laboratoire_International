# Services
msgid "Biochimie"
msgstr "الكيمياء الحيوية"

msgid "Analyses biochimiques complètes incluant glycémie, cholestérol, bilan hépatique et rénal."
msgstr "تحاليل كيميائية حيوية شاملة تشمل السكر والكولسترول وفحوصات الكبد والكلى."

msgid "Hématologie"
msgstr "أمراض الدم"

msgid "Numération formule sanguine, vitesse de sédimentation, bilan de coagulation."
msgstr "تعداد الدم الكامل، سرعة الترسيب، فحص التخثر."

msgid "Microbiologie"
msgstr "الأحياء الدقيقة"

